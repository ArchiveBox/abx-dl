{
  "properties": {
    "CURL_BINARY": {
      "default": "curl"
    },
    "DOCKER_BINARY": {
      "default": "docker"
    },
    "GH_BINARY": {
      "default": "gh"
    },
    "GIT_BINARY": {
      "default": "git"
    },
    "JQ_BINARY": {
      "default": "jq"
    },
    "SCRIPT_BINARY": {
      "default": "script"
    },
    "TEE_BINARY": {
      "default": "tee"
    },
    "UV_BINARY": {
      "default": "uv"
    }
  },
  "orchestration_binaries": [
    {
      "name": "{UV_BINARY}",
      "binproviders": "env,pip",
      "min_version": "0.13.5",
      "min_release_age": 0,
      "overrides": {
        "pip": {
          "install_args": [
            "uv==0.13.5"
          ]
        }
      }
    },
    {
      "name": "{CURL_BINARY}",
      "binproviders": "env,brew,apt"
    },
    {
      "name": "{GH_BINARY}",
      "binproviders": "env,brew,apt"
    },
    {
      "name": "{GIT_BINARY}",
      "binproviders": "env,brew,apt"
    },
    {
      "name": "{JQ_BINARY}",
      "binproviders": "env,brew,apt"
    }
  ],
  "docker_binaries": [
    {
      "name": "{DOCKER_BINARY}",
      "binproviders": "env"
    },
    {
      "name": "{SCRIPT_BINARY}",
      "binproviders": "env,apt",
      "overrides": {
        "env": {
          "version": [
            "script",
            "--version"
          ]
        },
        "apt": {
          "install_args": [
            "util-linux"
          ],
          "version": [
            "script",
            "--version"
          ]
        }
      }
    },
    {
      "name": "{TEE_BINARY}",
      "binproviders": "env,apt",
      "overrides": {
        "apt": {
          "install_args": [
            "coreutils"
          ]
        }
      }
    }
  ],
  "crawl_validation": {
    "browser_preparation_plugins": ["browserharness", "playwright", "puppeteer", "stagehand"],
    "required_plugin_outputs": {
      "autotag": ["autotag/analysis.json"],
      "autosummary": ["autosummary/summary.md", "autosummary/analysis.json"],
      "browserharness": ["browserharness/result.log"],
      "playwright": ["playwright/result.log"],
      "puppeteer": ["puppeteer/result.log"],
      "stagehand": ["stagehand/result.log"],
      "archivedotorg": [
        "archivedotorg/archive.org.txt"
      ],
      "dom": [
        "dom/output.html"
      ],
      "hashes": [
        "hashes/hashes.json"
      ],
      "parse_html_urls": [
        "parse_html_urls/urls.jsonl"
      ],
      "pdf": [
        "pdf/output.pdf"
      ],
      "readability": [
        "readability/content.html",
        "readability/content.txt",
        "readability/article.json"
      ],
      "screenshot": [
        "screenshot/screenshot.png"
      ],
      "singlefile": [
        "singlefile/singlefile.html"
      ],
      "title": [
        "title/title.txt"
      ],
      "wget": [
        "wget/*/index.html"
      ]
    }
  }
}
